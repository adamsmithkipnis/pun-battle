# Copy to .env and fill in. NEVER commit .env — it holds the app password.
# Use a Bluesky *app password* (Settings > Privacy and Security > App
# Passwords), never the account's real password.
BLUESKY_HANDLE=punbattle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# A new theme every ROUND_MINUTES, on the boundary (must divide 60: 60 = on
# the hour). Deadlines in posts are shown in TIMEZONE.
ROUND_MINUTES=60
TIMEZONE=America/Los_Angeles

# Points per round; tied winners split them. 60 splits evenly 2-6 ways.
ROUND_POINTS=60
# Fewest likes (not counting the author's own) that can win a round.
MIN_LIKES=1

# Variety. No category twice within CATEGORY_COOLDOWN rounds; no theme
# repeated within THEME_REPEAT_DAYS (the bot refuses to start below 90).
CATEGORY_COOLDOWN=24
THEME_REPEAT_DAYS=120

# Local hour whose post also shows the all-time top three.
LEADERBOARD_HOUR=12

DB_PATH=/Users/robot/pun-battle/punbattle.db
LOG_PATH=/Users/robot/pun-battle/punbattle.log

# 'live' posts to Bluesky. 'dry' writes posts to DRY_DIR and never uses the
# network — no credentials needed.
POST_MODE=live
DRY_DIR=dry-run

# Hashtags. HASHTAG_ALWAYS is on every theme post, followed by the topic's
# own tag, a family tag and rotating wordplay tags, up to MAX_HASHTAGS. The
# rotating pools live in config.py (versioned) — don't set HASHTAG_POOL here.
HASHTAG_ALWAYS=#PunBattle
MAX_HASHTAGS=6
# The one tag on replies to winners.
REPLY_HASHTAG=#PunBattle
