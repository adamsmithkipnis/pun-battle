<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.puntime.bot</string>

    <!-- EDIT: absolute paths. Use the repo's own .venv, not the system
         python, so dependencies are pinned and predictable. -->
    <key>ProgramArguments</key>
    <array>
        <string>/ABSOLUTE/PATH/TO/pun-time/.venv/bin/python</string>
        <string>/ABSOLUTE/PATH/TO/pun-time/main.py</string>
    </array>

    <!-- EDIT: project root (where .env lives) -->
    <key>WorkingDirectory</key>
    <string>/ABSOLUTE/PATH/TO/pun-time</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- EDIT: match LOG_PATH in .env for the bot. launchd redirects stdout
         here, which is why the code only adds a stdout log handler when
         stdout is a TTY — otherwise every line lands twice. -->
    <key>StandardOutPath</key>
    <string>/ABSOLUTE/PATH/TO/pun-time/puntime.log</string>
    <key>StandardErrorPath</key>
    <string>/ABSOLUTE/PATH/TO/pun-time/puntime.log</string>
</dict>
</plist>
